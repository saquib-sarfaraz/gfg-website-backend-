# Backend Environment Variables Template
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gfg_cmp?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Root Super Admin Bootstrapping (MANDATORY FOR BOOTSTRAP)
ROOT_ADMIN_EMAIL=admin@gfgcampus.org
ROOT_ADMIN_PASSWORD=your_secure_root_password_here
ROOT_ADMIN_PIN=123456
